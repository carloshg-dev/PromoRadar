{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promodetec",
  "workers_dev": false,
  "preview_urls": false,
  "main": "cloudflare-worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/BUILD_ID"], "fallthrough": true }],
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "promodetec"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1-isr-queue", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1",
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "2"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "promodetec-cache"
    }
  ],
  "observability": {
    "enabled": true
  }
}
